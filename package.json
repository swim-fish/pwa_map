{
  "name": "pwa-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Taiwan Coordinate Map — a PWA that renders a crosshair reticle with live multi-format coordinate readout.",
  "license": "MIT",
  "author": "Shihyu",
  "repository": {
    "type": "git",
    "url": "https://github.com/swim-fish/pwa_map.git"
  },
  "homepage": "https://swim-fish.github.io/pwa_map/",
  "bugs": {
    "url": "https://github.com/swim-fish/pwa_map/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench": "vitest bench --run",
    "bundle-size": "node scripts/check-bundle-size.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.48.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.7.0",
    "@types/proj4": "^2.5.5",
    "@vitest/ui": "^2.1.2",
    "eslint": "^9.12.0",
    "eslint-plugin-svelte": "^2.46.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.7",
    "svelte": "^4.2.19",
    "svelte-check": "^4.0.4",
    "tslib": "^2.7.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.2",
    "workbox-window": "^7.1.0"
  },
  "dependencies": {
    "maplibre-gl": "^3.6.2",
    "mgrs": "^2.1.0",
    "proj4": "^2.12.1"
  }
}
